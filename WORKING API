def encode_audio(audio_data: np.ndarray) -> Optional[str]:
    """Encode audio data to base64 string"""
    if audio_data is None or not isinstance(audio_data, np.ndarray) or audio_data.size == 0:
        return None

    try:
        # Convert to WAV format
        with io.BytesIO() as wav_file:
            sf.write(wav_file, audio_data, 44100, format='WAV')
            wav_data = wav_file.getvalue()

        # Encode to base64
        return base64.b64encode(wav_data).decode('utf-8')
    except Exception as e:
        print(f"Error encoding audio: {str(e)}")
        return None

