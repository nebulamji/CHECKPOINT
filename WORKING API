# Helper functions
def extract_melody_info(score: stream.Score) -> List[Dict[str, Any]]:
    """Extract melodic information from score"""
    melody_info = []
    for n in score.flatten().getElementsByClass('Note'):
        melody_info.append({
            "pitch": n.nameWithOctave,
            "duration": n.duration.quarterLength,
            "offset": n.offset
        })
    return melody_info

def extract_harmony_info(score: stream.Score) -> List[Dict[str, Any]]:
    """Extract harmonic information from score"""
    harmony_info = []
    for c in score.flatten().getElementsByClass('ChordSymbol'):
        harmony_info.append({
            "symbol": c.figure,
            "duration": c.duration.quarterLength,
            "offset": c.offset
        })
    return harmony_info

def analyze_rhythm(score: stream.Score) -> List[str]:
    """Analyze rhythmic patterns in the score"""
    patterns = []

    # Get all notes from the score
    notes = score.flatten().getElementsByClass('Note')

    # Look for common rhythmic patterns
    durations = [n.duration.quarterLength for n in notes]

    # Check for swing feel (mix of 1.5 and 0.5 quarter lengths)
    if any(d == 1.5 for d in durations) and any(d == 0.5 for d in durations):
        patterns.append("swing")

    # Check for straight eighths (lots of 0.5 quarter lengths)
    if durations.count(0.5) > len(durations) / 3:
        patterns.append("straight eighths")

    # Check for triplet feel
    if any(d == 2/3 for d in durations):
        patterns.append("triplet feel")

    # Default pattern if none detected
    if not patterns:
        patterns.append("basic rhythm")

    return patterns

