def detect_genre(score: stream.Score) -> List[str]:
    """Detect musical genre indicators from score"""
    genres = []

    # Check for swing rhythm
    if any(n.duration.quarterLength == 1.5 for n in score.flatten().getElementsByClass('Note')):
        genres.append("jazz")

    # Check for blues patterns
    if any(n.name == 'Bb' for n in score.flatten().getElementsByClass('Note')):
