async def transcribe_audio(y, sr):
    """Advanced transcription using Magenta's Onsets and Frames"""
    try:
        print("Starting transcription...")
        print(f"Input audio: shape={y.shape}, sr={sr}")

        # Ensure audio is mono and at correct sample rate
        if len(y.shape) > 1:
            y = librosa.to_mono(y)
            print("Converted audio to mono")

        # Normalize audio
        y = librosa.util.normalize(y)
        print("Normalized audio")

        # Convert to float32
        y = y.astype(np.float32)
        print("Converted to float32")

        # Create a NoteSequence using Magenta's transcription model
        sequence = note_seq.sequences_lib.NoteSequence()
        print("Created NoteSequence")

        # Extract pitch using librosa
        print("Extracting pitch information...")
        pitches, magnitudes = librosa.piptrack(y=y, sr=sr)
        onset_frames = librosa.onset.onset_detect(y=y, sr=sr)
        onset_times = librosa.frames_to_time(onset_frames, sr=sr)
        print(f"Found {len(onset_times)} onsets")

        # Convert detected pitches to MIDI notes
        notes_info = []

        for i, onset_time in enumerate(onset_times):
            if i < len(onset_frames):
                frame = onset_frames[i]
                if frame < pitches.shape[1]:
                    # Find the strongest pitch at this onset
                    pitch_index = magnitudes[:, frame].argmax()
                    pitch = pitches[pitch_index, frame]

                    if pitch > 0:  # Valid pitch detected
                        # Convert Hz to MIDI note number
                        midi_note = int(round(librosa.hz_to_midi(pitch)))

                        # Add note to sequence
                        note = sequence.notes.add()
                        note.start_time = float(onset_time)
                        note.end_time = float(onset_times[i + 1] if i + 1 < len(onset_times) else len(y)/sr)
                        note.pitch = midi_note
                        note.velocity = 64  # Default velocity
                        note.program = 0    # Default to piano

                        # Add to our notes info
                        notes_info.append({
                            "pitch": midi_note,
                            "start_time": note.start_time,
                            "end_time": note.end_time,
                            "velocity": note.velocity,
                            "program": note.program
                        })

        print(f"Extracted {len(notes_info)} notes")

        # Add tempo information
        tempo = note_seq.sequences_lib.TempoChange()
        tempo.time = 0
        tempo.qpm = float(librosa.beat.tempo(y=y, sr=sr)[0])
        sequence.tempos.append(tempo)
        print(f"Added tempo: {tempo.qpm} QPM")

        # Add time signature (default to 4/4)
        ts = note_seq.sequences_lib.TimeSignature()
        ts.time = 0
        ts.numerator = 4
        ts.denominator = 4
        sequence.time_signatures.append(ts)
        print("Added time signature")

        result = {
            "notes": notes_info,
            "tempo": sequence.tempos[0].qpm if sequence.tempos else 120,
            "time_signatures": [(ts.numerator, ts.denominator) for ts in sequence.time_signatures]
        }
        print("Transcription completed successfully")
        return result

    except Exception as e:
        print(f"Error in transcribe_audio: {str(e)}")
        import traceback
        traceback.print_exc()
        raise HTTPException(status_code=500, detail=f"Transcription failed: {str(e)}")

