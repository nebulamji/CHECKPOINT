        genres.append("jazz")

    return genres

def analyze_harmony_patterns(score: stream.Score) -> List[str]:
    """Analyze harmonic patterns in the score"""
    patterns = []

    # Look for common jazz patterns
    chord_symbols = [c.figure for c in score.flatten().getElementsByClass('ChordSymbol')]

    # Check for ii-V-I
    for i in range(len(chord_symbols) - 2):
        if ('m7' in chord_symbols[i] and
            '7' in chord_symbols[i+1] and
            'maj7' in chord_symbols[i+2]):
            patterns.append("ii-V-I progression")

    # Check for blues changes
    if len(chord_symbols) >= 12:
        if all(c.endswith('7') for c in chord_symbols[:12]):
            patterns.append("12-bar blues")

    return patterns

def analyze_form(score: stream.Score) -> Dict[str, Any]:
    """Analyze form of the piece"""
    sections = []
    try:
        # Get all parts from the score
        parts = score.parts if score.parts else [score]

        for part in parts:
            # Get measures from the part
            measures = part.getElementsByClass('Measure')
            if measures:
                current_section = {"start_measure": 0, "harmony": []}

                for i, measure in enumerate(measures):
                    # Check for double barlines or repeat signs
                    if (hasattr(measure, 'rightBarline') and
                        measure.rightBarline and
                        measure.rightBarline.type != 'regular'):
                        current_section["end_measure"] = i
                        current_section["harmony"] = extract_harmony_info(
                            stream.Stream(measures[current_section["start_measure"]:i+1])
                        )
                        sections.append(current_section)
                        current_section = {"start_measure": i + 1, "harmony": []}

                # Add the last section if it hasn't been added
                if not sections or sections[-1]["end_measure"] < len(measures) - 1:
                    sections.append({
                        "start_measure": current_section["start_measure"],
                        "end_measure": len(measures) - 1,
                        "harmony": extract_harmony_info(
                            stream.Stream(measures[current_section["start_measure"]:])
                        )
                    })

        # If no sections found, create a default section
        if not sections:
            sections.append({
                "start_measure": 0,
                "end_measure": 0,
                "harmony": extract_harmony_info(score)
            })

    except Exception as e:
        print(f"Error analyzing form: {str(e)}")
        # Return a default form if analysis fails
        sections = [{
            "start_measure": 0,
            "end_measure": 0,
            "harmony": []
        }]

    return {"sections": sections}

