    if re.search(r'ballad|slow', text, re.I):
        style_markers.append("Ballad")
        concepts.append("Expressive Playing")

    # Check for musical concepts
    if re.search(r'ii-?V-?I|251', text, re.I):
        concepts.append("II-V-I Progressions")
    if re.search(r'modal|dorian|mixolydian', text, re.I):
        concepts.append("Modal Harmony")
    if re.search(r'syncopat|offbeat', text, re.I):
        concepts.append("Rhythmic Development")

    return {
        "markers": style_markers,
        "concepts": concepts
    }

def extract_key_signature(text: str) -> str:
    """Extract key signature from OCR text"""
    # Look for key signature indicators
    key_pattern = r'(?:Key|Key Signature):\s*([A-G][#b]?\s*(?:major|minor|maj|min|m)?)'
    match = re.search(key_pattern, text, re.I)
    if match:
        return match.group(1)
    return "C major"  # Default key

def extract_time_signature(text: str) -> str:
    """Extract time signature from OCR text"""
    # Look for time signature indicators
    time_pattern = r'(?:Time|Time Signature):\s*(\d+/\d+)'
    match = re.search(time_pattern, text, re.I)
    if match:
        return match.group(1)
    return "4/4"  # Default time signature

