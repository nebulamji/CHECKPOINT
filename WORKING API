            temp_file.write(contents)
            temp_path = temp_file.name
            print(f"Saved audio to temporary file: {temp_path}")

        # Load and validate audio
        try:
            y, sr = librosa.load(temp_path, sr=None)
            print(f"Loaded audio: shape={y.shape}, sr={sr}")
