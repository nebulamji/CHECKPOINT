def convert_pitch_to_number(pitch: str) -> int:
    """Convert pitch string (e.g., 'C4') to MIDI note number"""
    try:
        note_name = pitch[:-1]  # Remove octave number
        octave = int(pitch[-1])
        base_notes = {'C': 0, 'D': 2, 'E': 4, 'F': 5, 'G': 7, 'A': 9, 'B': 11}
        base = base_notes[note_name[0]]

        # Handle sharps and flats
        if len(note_name) > 1:
            if note_name[1] == '#':
                base += 1
            elif note_name[1] == 'b':
                base -= 1

        return base + (octave + 1) * 12
    except:
        return 60  # Default to middle C

