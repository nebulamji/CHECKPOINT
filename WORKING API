            print(f"Error loading audio: {str(audio_error)}")
            raise HTTPException(status_code=400, detail=f"Invalid audio file: {str(audio_error)}")

        # Validate audio format
        if not isinstance(y, np.ndarray):
            raise HTTPException(status_code=400, detail="Invalid audio format: not a numpy array")

        # Advanced Analysis
        try:
            transcription = await transcribe_audio(y, sr)
            print("Transcription completed successfully")

            analysis = {
